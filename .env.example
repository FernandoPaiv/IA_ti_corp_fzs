# Copy to .env for local development. Never put real values in this file.

# Supabase Database > Connect:
# Runtime uses Supavisor transaction pooler (port 6543).
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Direct database connection (port 5432), used by Prisma Migrate only.
DIRECT_URL="postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres"

# Supabase Project Settings > API.
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_ANON_KEY=""
# Used only by the explicit user-seed scripts; never configure in the frontend.
SUPABASE_SERVICE_ROLE_KEY=""

# One or more exact browser origins, comma-separated. Use HTTPS outside localhost.
FRONTEND_ORIGIN="http://localhost:5173"

# Optional. Defaults to the Supabase JWKS endpoint derived from SUPABASE_URL.
# Must remain on the same origin and use the standard Supabase Auth JWKS path.
JWKS_URI=""

# Optional: image search remains available as an empty result without a key.
PIXABAY_API_KEY=""

# User-creation scripts only. Leave unset except for a deliberate, reviewed run.
SEED_CONFIRMATION=""
SEED_EXPECTED_SUPABASE_URL=""
SEED_EXPECTED_DATABASE_HOST=""
TENANT_SEED_CONFIRMATION=""
INITIAL_PROFESSOR_PASSWORD=""
QA_USER_EMAIL=""
QA_USER_PASSWORD=""
QA_USER_FULL_NAME="Usuário QA"

# The hosting platform supplies PORT in production; local default is 3000.
PORT=3000
