# Copy this file to .env and fill in the real values.
# Supabase / PostgreSQL connection (pooler endpoint, ADR-001 §5)
# Host    : aws-0-<region>.pooler.supabase.com
# Port    : 6543 (runtime) / 5432 (migration)
# Database: postgres
# User    : postgres.<project-ref>
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD_HERE@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# CORS (ADR-001 §7) — origem do front autorizada a chamar esta API.
FRONTEND_ORIGIN="http://localhost:5173"

# Servidor
PORT=3000

# Vercel Connector (@vercel/connect)
# Runtime token via: getToken(CONNECTION_NAME, { subject: { type: "app" } });
CONNECTION_NAME="ti_corp_fzs/almond-ferry"
CONNECTION_SUBJECT_TYPE="app"